# Site
NEXT_PUBLIC_SITE_URL=https://www.example.org

# Sanity CMS (leave empty to run with empty states)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: read token, only needed if the dataset is private. Server-side only.
SANITY_API_READ_TOKEN=
# Optional: secret used by the Sanity publish webhook to revalidate pages
SANITY_REVALIDATE_SECRET=

# Contact form email delivery (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=EEM Website <noreply@example.org>

# Public contact details (leave empty until confirmed)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Analytics (loaded only after cookie consent). Example: Google tag ID
NEXT_PUBLIC_GA_ID=
